{
  "name": "rendering",
  "version": "0.1.0",
  "private": true,
  "description": "Renders a composition.json into an MP4 with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render VideoComposition out/video.mp4",
    "still": "remotion still VideoComposition out/still.png",
    "typecheck": "tsc --noEmit",
    "check:scenes": "node scripts/check-scenes.mjs",
    "validate": "node scripts/validate-composition.mjs",
    "check:visual": "node scripts/render-scene-checks.mjs",
    "previews": "node scripts/render-previews.mjs",
    "sfx": "node scripts/make-sfx.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/shapes": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "katex": "0.19.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.187.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/d3-geo": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "@types/topojson-client": "3.1.5",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
