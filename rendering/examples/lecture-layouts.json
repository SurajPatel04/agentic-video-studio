        "levels": [
          {
            "label": "Views",
            "value": 1200,
            "at": 0
          },
          {
            "label": "Product page visits",
            "value": 420,
            "at": 0.23
          },
          {
            "label": "Added to cart",
            "value": 95,
            "at": 0.45
          },
          {
            "label": "Completed purchase",
            "value": 48,
            "at": 0.66
          }
        ]
      }
    },
    {
      "id": "pyramid",
      "component": "LayersScene",
      "durationInFrames": 150,
      "props": {
        "title": "Five levels in Maslow’s hierarchy",
        "mode": "pyramid",
        "levels": [
          {
            "label": "Self-actualization",
            "detail": "Develop your potential.",
            "at": 0.0
          },
          {
            "label": "Esteem",
            "detail": "Feel capable and respected.",
            "at": 0.12
          },
          {
            "label": "Belonging",
            "detail": "Connect with others.",
            "at": 0.24
          },
          {
            "label": "Safety",
            "detail": "Feel secure.",
            "at": 0.36
          },
          {
            "label": "Physiological needs",
            "detail": "Meet basic bodily needs.",
            "at": 0.48
          }
        ]
      }
    },
    {
      "id": "inverted-pyramid",
      "component": "LayersScene",
      "durationInFrames": 150,
      "props": {
        "title": "Put the most important news first",
        "mode": "inverted",
        "levels": [
          {
            "label": "Lead",
            "detail": "Open with the essential facts.",
            "at": 0.0
          },
          {
            "label": "Supporting details",
            "detail": "Explain what happened and why it matters.",
            "at": 0.12
          },
          {
            "label": "Background",
            "detail": "Add context readers can use to understand the story.",
            "at": 0.24
          }
        ]
      }
    },
    {
      "id": "osi-stack",
      "component": "LayersScene",
      "durationInFrames": 270,
      "props": {
        "title": "The seven OSI layers",
        "mode": "stack",
        "levels": [
          {
            "label": "7 Application",
            "at": 0.0,
            "detail": "Gives applications access to network services."
          },
          {
            "label": "6 Presentation",
            "at": 0.1,
            "detail": "Formats data so the receiving application can interpret it."
          },
          {
            "label": "5 Session",
            "at": 0.2,
            "detail": "Manages the conversation between applications."
          },
          {
            "label": "4 Transport",
            "at": 0.3,
            "detail": "Transfers data between the end systems."
          },
          {
            "label": "3 Network",
            "at": 0.4,
            "detail": "Routes packets between networks."
          },
          {
            "label": "2 Data link",
            "at": 0.5,
            "detail": "Moves frames across a local link."
          },
          {
            "label": "1 Physical",
            "at": 0.6,
            "detail": "Sends bits as electrical, optical, or radio signals."
          }
        ]
      }
    },
    {
      "id": "quadrants",
      "component": "MatrixScene",
      "durationInFrames": 150,
      "props": {}
    },
    {
      "id": "spectrum",
      "component": "MatrixScene",
      "durationInFrames": 150,
      "props": {
        "title": "Match the tone to the audience",
        "mode": "spectrum",
        "xAxis": {
          "label": "Writing tone",
          "low": "Informal",
          "high": "Formal"
        },
        "markers": [
          {
            "label": "Group chat",
            "x": 0.14,
            "at": 0.16
          },
          {
            "label": "Customer update",
            "x": 0.36,
            "at": 0.31,
            "moves": [
              {
                "x": 0.57,
                "at": 0.68
              }
            ]
          },
          {
            "label": "Official notice",
            "x": 0.87,
            "at": 0.47
          }
        ]
      }
    },
    {
      "id": "hotspots",
