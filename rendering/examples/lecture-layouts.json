{
  "fps": 30,
  "width": 1920,
  "height": 1080,
  "brand": {
    "intro": false,
    "watermark": false
  },
  "audio": {
    "effects": false
  },
  "defaultTransition": {
    "type": "fade",
    "durationInFrames": 15
  },
  "scenes": [
    {
      "id": "aida",
      "component": "LayersScene",
      "durationInFrames": 150,
      "props": {}
    },
    {
      "id": "sales-funnel",
