# Credentials go in the URI; they become the gateway's Basic auth header.
MLFLOW_TRACKING_URI=https://user:password@dev.landnextrole.com/mlflow
# Optional override; defaults to {MLFLOW_TRACKING_URI}/gateway/openai/v1
# MLFLOW_GATEWAY_BASE_URL=https://dev.landnextrole.com/mlflow/gateway/openai/v1
# MLflow gateway route name used when a request doesn't pass "model"
DEFAULT_MODEL=summary

# Deepgram text-to-speech (narration): used by backend/app/utils/tts.py
DEEPGRAM_TTS_API_KEY=

# Live harness smoke uses this OpenAI API key exclusively.
TEST=
# Component agent history and conservative input reservations.
AGENT_HISTORY_TURNS=3
AGENT_MAX_CONTEXT_TOKENS=60000
AGENT_MAX_INPUT_TOKENS=250000
# Skill routing: typesafe (keyword fallback) | llm (planner provider) | keyword.
SKILL_ROUTER=typesafe
TYPESAFE_API_KEY=
SKILL_ROUTER_MODEL=
# Overlap streamed scene planning with validation, audio and rendering.
STREAM_VIDEO_SCENES=true
# Deepgram: requests at once (higher plans allow more) and tries per request on 429 / errors
DEEPGRAM_CONCURRENCY=4
DEEPGRAM_RETRIES=6

# Celery connections for video jobs
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_VIDEO_QUEUE=video
VIDEO_JOB_RUNNER=local
CELERY_VISIBILITY_TIMEOUT=86400
# Jobs at once per worker machine; one worker process runs one whole job (plan + voice + render).
# Render threads are split across them (cores / CELERY_WORKERS, at least 1).
CELERY_WORKERS=50
CELERY_JOBS_PER_PROCESS=1
# Job status, progress, timings, cost and logs in Redis (keys video:job:<id>, :log, :alive and the
# video:jobs index), each kept JOB_TTL_SECONDS. Files in workspace/ stay the source of truth.
# Production: the queue (CELERY_BROKER_URL) must never be evicted. Either point JOB_REDIS_URL at its own
# Redis with maxmemory + maxmemory-policy volatile-ttl, or keep one Redis with noeviction and watch memory.
# Turn on appendonly (AOF) for the broker's Redis so queued jobs survive a Redis restart.
JOB_REDIS_URL=redis://127.0.0.1:6379/2
JOB_TTL_SECONDS=604800
JOB_LOG_MAX=2000
JOB_LOG_MAX_CHARS=2000
JOB_HEARTBEAT_SECONDS=5
# true = LLM prompts and replies also go to the Redis job log (up to ~4 MB per job; may hold user data)
JOB_LOG_PROMPTS=false

# Optional LLM pricing by reported model name, in USD per million tokens.
# Each entry takes input, cached_input, output, and optionally cached_output.
LLM_PRICING_USD_PER_MTOK={}
