# Credentials go in the URI; they become the gateway's Basic auth header.
MLFLOW_TRACKING_URI=https://user:password@dev.landnextrole.com/mlflow
# Optional override; defaults to {MLFLOW_TRACKING_URI}/gateway/openai/v1
# MLFLOW_GATEWAY_BASE_URL=https://dev.landnextrole.com/mlflow/gateway/openai/v1
# MLflow gateway route name used when a request doesn't pass "model"
DEFAULT_MODEL=summary

# Deepgram text-to-speech (narration): used by backend/app/utils/tts.py
DEEPGRAM_TTS_API_KEY=

# Live harness smoke uses this OpenAI API key exclusively.
TEST=
# Component agent history and conservative input reservations.
AGENT_HISTORY_TURNS=3
AGENT_MAX_CONTEXT_TOKENS=60000
AGENT_MAX_INPUT_TOKENS=250000
# Skill (teaching guide) selection: llm = one small call reads the guide descriptions (keyword fallback) | keyword
SKILL_ROUTER=llm
SKILL_ROUTER_MODEL=
# Deepgram: requests at once (higher plans allow more) and tries per request on 429 / errors
DEEPGRAM_CONCURRENCY=4
DEEPGRAM_RETRIES=6

# Celery connections for video jobs
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_VIDEO_QUEUE=video
